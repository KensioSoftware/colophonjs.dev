---
// src/components/Head.astro
// Overrides Starlight's <Head> so every page gets its own social meta image and
// its JSON-LD.
//
// The cards are generated by `pnpm meta-img` (see colophon.config.ts), which
// records each page's image, size and URL in the manifest below. Colophon's
// `metaTags` turns the entry for this route into the tags to emit. Pages are
// keyed by route slug, so the home page maps to `index`.
import { metaTags } from "@kensio/colophon/meta";
import type { Manifest } from "@kensio/colophon";

import DefaultHead from "@astrojs/starlight/components/Head.astro";
import manifest from "../data/colophon.json";
import {
  serialise,
  slugFromPathname,
  structuredData,
} from "../lib/structured-data";

const route = Astro.locals.starlightRoute;

const slug = slugFromPathname(Astro.url.pathname);

// Alt text in the manifest is the page title alone. These cards are read away
// from the site, where a title like "Placement" does not say what it is about.
const suffix = " (Colophon docs)";
const tags = metaTags(manifest as Manifest, slug, {
  baseUrl: Astro.site?.href,
}).map((tag) =>
  ("property" in tag ? tag.property : tag.name).endsWith(":image:alt")
    ? { ...tag, content: `${tag.content}${suffix}` }
    : tag,
);

// Colophon picks the card type from the image it actually generated, so drop
// Starlight's hardcoded default rather than emitting the tag twice.
route.head = route.head.filter((tag) => tag.attrs?.name !== "twitter:card");

// `Astro.site` is set in astro.config.mjs, so this only falls back when someone
// has removed it, and then the absolute URLs are wrong anyway.
const baseUrl = Astro.site?.href ?? "https://colophonjs.dev/";

const jsonLd = structuredData({
  manifest: manifest as Manifest,
  pathname: Astro.url.pathname,
  baseUrl,
  title: route.entry.data.title,
  description: route.entry.data.description ?? "",
});
---

<DefaultHead />

{tags.map((tag) => <meta {...tag} />)}

<script type="application/ld+json" is:inline set:html={serialise(jsonLd)} />
